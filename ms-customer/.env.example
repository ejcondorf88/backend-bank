# ============================================================================
# CONFIGURACION DE ENTORNO - ms-customer
# ============================================================================
# Copiar este archivo a .env y modificar segun necesidad
#
# Opciones:
# 1. RAILWAY + LOCAL: BD en Railway, Eureka/RabbitMQ/Gateway locales
# 2. TODO LOCAL: Todo en Docker local (PostgreSQL, Eureka, RabbitMQ)
# ============================================================================

# ============================================================================
# OPCION 1: RAILWAY + LOCAL (recomendado)
# BD en Railway, servicios locales (Eureka, RabbitMQ, Gateway)
# ============================================================================

# Perfil activo - railway para usar BD Railway
SPRING_PROFILES_ACTIVE=railway

# Base de datos Railway
DATABASE_URL=jdbc:postgresql://switchback.proxy.rlwy.net:33642/railway?currentSchema=customer&sslmode=require
DATABASE_USER=postgres
DATABASE_PASSWORD=aJrCigJkyYokNwRvpRggQKpaXkDXbduK
DATABASE_SCHEMA=customer

# Eureka local (para service discovery)
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_ENABLED=true

# RabbitMQ local (para eventos)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Version de la app
APP_VERSION=1.0.0

# ============================================================================
# OPCION 2: TODO LOCAL (comentar opcion 1 y descomentar esto)
# Todo en Docker local
