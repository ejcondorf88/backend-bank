# ============================================================================
# Backend Bank - Variables de Entorno
# ============================================================================
# Copia este archivo como .env y completa los valores reales:
#   cp .env.example .env
# ============================================================================

# PostgreSQL (Railway)
DATABASE_URL=jdbc:postgresql://localhost:5432/bankdb
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SCHEMA=customer

# ms-account schema (separado para cada microservicio)
DATABASE_SCHEMA_ACCOUNT=account
DATABASE_SCHEMA_CUSTOMER=customer